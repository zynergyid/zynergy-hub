# Postgres (local dev: docker container zynergy-pg, port 5433, database zynergy_hub)
DATABASE_URI=postgres://postgres:zynergy-dev@127.0.0.1:5433/zynergy_hub

# Payload auth secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob for receipts. Empty locally (files go to ./receipts on disk).
BLOB_READ_WRITE_TOKEN=
